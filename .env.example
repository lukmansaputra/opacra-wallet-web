# CONTOH NAMA VARIABEL SAJA — jangan isi nilai asli di file ini.
# Isi nilai asli di Vercel Dashboard (backend/frontend) dan di .env worker ai-server.
# JANGAN commit file .env yang sudah terisi.

# --- Supabase (sama untuk backend + worker + frontend Auth) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Frontend (Vite, di-inline saat build) ---
VITE_API_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Backend Vercel (server-side only) ---
SEND_RATE_LIMIT_PER_MINUTE=
MAX_SEND_OPCA=

# --- Worker ai-server (lihat worker/.env.example) ---
OPACRA_WALLET_CLI=
OPACRA_WALLET_FILE=
OPACRA_WALLET_PASSWORD_FILE=
OPACRA_SEND_PIN_HASH_FILE=
OPACRA_DAEMON_HOST=
OPACRA_DAEMON_PORT=
XMRIG_LOG_FILE=
WORKER_POLL_SECONDS=
WORKER_SYNC_SECONDS=
