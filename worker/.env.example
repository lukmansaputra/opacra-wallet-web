# Worker ai-server — isi nilai asli di ai-server SAJA, jangan commit .env.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# opacra-wallet-cli (pola refresh terbukti: --command refresh < password file)
OPACRA_WALLET_CLI=/home/user/opacra/opacra-wallet-cli
OPACRA_WALLET_FILE=/home/user/opacra/wallet
OPACRA_WALLET_PASSWORD_FILE=/home/user/opacra/.wallet-password.txt
OPACRA_DAEMON_HOST=127.0.0.1
OPACRA_DAEMON_PORT=18081
# PIN: HANYA hash scrypt di file ini (dibuat via node scripts/set-pin.js).
# JANGAN tulis PIN plaintext di file ini / env / log.
OPACRA_SEND_PIN_HASH_FILE=/home/user/opacra/.send-pin-hash.txt
# Mining (opsional)
XMRIG_LOG_FILE=/home/user/opacra/xmrig/xmrig.log
XMRIG_API_URL=http://127.0.0.1:18088/2/summary
MINING_POOL=NurseryPool
# Interval
WORKER_POLL_SECONDS=5
WORKER_SYNC_SECONDS=30
# Lockout PIN
PIN_MAX_ATTEMPTS=3
PIN_LOCK_MINUTES=15
MAX_SEND_OPCA=10
